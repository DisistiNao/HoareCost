name:                HoareCost
version:             0.1.0.0
-- synopsis:
-- description:
-- bug-reports:
-- license:             NONE
license-file:        LICENSE
author:              DisistiNao
maintainer:          gabrielsaldanha373@gmail.com
-- copyright:
-- category:
build-type:          Simple
extra-source-files:  CHANGELOG.md

library
  exposed-modules:
    Lexer.Lexer,
    Oracle,
    Parser.Parser,
    Solver,
    Syntax,
    Utils,
    Variables,
    VCGen
  hs-source-dirs:      src
  build-depends:
    array,
    base >=4.13 && <4.22,
    containers,
    sbv < 9.0
  build-tools:         alex, happy
  default-language:    Haskell2010

executable HoareCost
  main-is:             Main.hs
  -- other-modules:
  -- other-extensions:
  build-depends:
    base >=4.13 && <4.22,
    HoareCost
  -- hs-source-dirs:
  default-language:    Haskell2010

executable compiler
  main-is:             Main.hs
  hs-source-dirs:      compiler
  build-depends:
    array,
    base >=4.13 && <4.22,
    HoareCost
  default-language:    Haskell2010